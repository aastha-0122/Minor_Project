# MediTrack Healthcare Inventory - Environment Variables

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Database Configuration (MySQL)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/meditrack
# Fallback SQLite option for local testing if MySQL is not yet configured:
# DATABASE_URL=sqlite:///meditrack.db

# CORS Configuration (Allowed Frontend Origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Clinical Expiry Thresholds (Days)
NEAR_EXPIRY_DAYS=30
UPCOMING_EXPIRY_DAYS=90

# Mail Server Settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=notifications@meditrack.org
MAIL_PASSWORD=your-email-app-password
MAIL_DEFAULT_SENDER=MediTrack Alerts <notifications@meditrack.org>

# Scheduler Settings
ENABLE_SCHEDULER=True
SCHEDULER_INTERVAL_HOURS=24
